{
  "name": "labelbk",
  "version": "1.0.0",
  "private": true,
  "description": "Cour de cassation annotation tool.",
  "scripts": {
    "compile": "tsc && tsc-alias && cp -r src/courDeCassation/settings dist/courDeCassation/settings",
    "start:dev": "nodemon",
    "start:docker": "docker compose up -d",
    "test": "NODE_ENV=TEST jest --passWithNoTests --verbose --runInBand",
    "format": "prettier \"src/**/*.ts\" --check",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "fix": "eslint \"src/**/*.ts\" --fix && prettier \"src/**/*.ts\" --write"
  },
  "dependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "axios": "1.11.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dbsder-api-types": "2.1.46",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "joi": "18.0.1",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.17.21",
    "mongodb": "6.18.0",
    "pino": "^10.3.1",
    "samlify": "2.10.1",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.20",
    "@types/mongodb": "4.0.7",
    "@types/node": "22.17.2",
    "@types/yargs": "17.0.33",
    "@typescript-eslint/eslint-plugin": "8.40.0",
    "@typescript-eslint/parser": "8.40.0",
    "core-js": "3.45.1",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "30.0.5",
    "nodemon": "3.1.10",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "ts-jest": "29.4.1",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.2"
  }
}
