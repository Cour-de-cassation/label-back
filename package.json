{
  "name": "labelbk",
  "version": "1.0.0",
  "private": true,
  "description": "Cour de cassation annotation tool.",
  "scripts": {
    "compile": "tsc && tsc-alias && cp -r src/courDeCassation/settings dist/courDeCassation/settings",
    "start:dev": "nodemon",
    "start:docker": "docker compose up -d",
    "test": "NODE_ENV=TEST jest --passWithNoTests --verbose --runInBand",
    "format": "prettier \"src/**/*.ts\" --check",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "fix": "eslint \"src/**/*.ts\" --fix && prettier \"src/**/*.ts\" --write"
  },
  "dependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "axios": "1.16.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dbsder-api-types": "3.0.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "joi": "18.2.1",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "mongodb": "7.2.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "samlify": "2.13.1",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "24.10.9",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "core-js": "3.49.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.10",
    "tsc-alias": "1.8.17",
    "typescript": "5.9.3"
  }
}
