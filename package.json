{
  "name": "labelbk",
  "version": "1.0.0",
  "private": true,
  "description": "Cour de cassation annotation tool.",
  "scripts": {
    "compile": "tsc && tsc-alias && cp -r src/courDeCassation/settings dist/courDeCassation/settings",
    "start:dev": "nodemon",
    "start:docker": "docker compose up -d",
    "test": "NODE_ENV=TEST jest --passWithNoTests --verbose --runInBand",
    "format": "prettier \"src/**/*.ts\" --check",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "fix": "eslint \"src/**/*.ts\" --fix && prettier \"src/**/*.ts\" --write"
  },
  "dependencies": {
    "axios": "1.21.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dbsder-api-types": "3.2.11",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "joi": "18.3.1",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "mongodb": "7.7.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "samlify": "2.15.1",
    "yargs": "17.7.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/node-rsa": "1.1.4",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@types/jsonwebtoken": "9.0.10",
    "core-js": "3.51.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "npm": "11.21.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.15",
    "tsc-alias": "1.9.9",
    "typescript": "6.0.3"
  }
}