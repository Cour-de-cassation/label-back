{
  "compilerOptions": {
    "lib": ["ES2022"],
    "declaration": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": { "@src/*": ["./src/*"] },
    "removeComments": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["jest"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*"]
}
